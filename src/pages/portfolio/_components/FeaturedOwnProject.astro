---
<section class="section-featured-project" id="featured">
  <div class="container">
    <div class="fp-wrapper">
      
      <div class="fp-grid">
        
        <!-- Left: Metadata -->
        <div class="fp-meta">
          <span class="fp-type">Proiect propriu · Website companie</span>
          <h2 class="fp-name">Pop Digital Solutions EU</h2>
          <div class="fp-tags">
            <span>Poziționare</span>
            <span class="dot">·</span>
            <span>Arhitectura informației</span>
            <span class="dot">·</span>
            <span>Concept de conținut</span>
            <span class="dot">·</span>
            <span>Parcursul utilizatorului</span>
          </div>
        </div>
        
        <!-- Right: Narrative -->
        <div class="fp-narrative">
          <p class="fp-text">
            Principala provocare a fost organizarea soluțiilor digitale, a marketingului și designului, precum și echiparea companiilor cu o prezență ușor de înțeles, cu puncte de intrare clare.
          </p>
          <p class="fp-text">
            Website-ul a fost reproiectat de la zero. Accentul a fost pus pe poziționare, arhitectura informației, conceptul de conținut, parcursul utilizatorului și rolul personal al lui Gabriel Pop.
          </p>
          
          <div class="fp-action">
            <!-- Link will become active when case study is published -->
            <a href="#" class="fp-link disabled" aria-disabled="true">
              Citiți studiul de caz
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <span class="fp-gate-note">Acest studiu de caz va fi publicat împreună cu versiunea finală a website-ului.</span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  .section-featured-project {
    padding: 6rem 0;
    background: var(--bg-page);
  }

  .fp-wrapper {
    background: #ffffff;
    border: 1px solid var(--border-light);
    padding: 6rem 5rem;
    box-shadow: 0 4px 40px rgba(0,0,0,0.02);
  }

  .fp-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 6rem;
    align-items: start;
  }

  /* Meta Side */
  .fp-meta {
    display: flex;
    flex-direction: column;
    border-top: 2px solid var(--brand-navy);
    padding-top: 1.5rem;
  }

  .fp-type {
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .fp-name {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--brand-navy);
    line-height: 1.1;
    margin-bottom: 2rem;
  }

  .fp-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    color: var(--brand-purple);
  }
  .fp-tags .dot {
    color: var(--border-subtle);
  }

  /* Narrative Side */
  .fp-narrative {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .fp-text {
    font-size: 1.25rem;
    color: var(--text-dark);
    line-height: 1.6;
    margin: 0;
  }

  .fp-action {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .fp-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--brand-navy);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.3s;
  }
  .fp-link svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s;
  }
  .fp-link:hover:not(.disabled) {
    color: var(--brand-purple);
  }
  .fp-link:hover:not(.disabled) svg {
    transform: translateX(4px);
  }
  
  .fp-link.disabled {
    color: var(--text-muted);
    cursor: not-allowed;
    pointer-events: none;
  }

  .fp-gate-note {
    font-size: 0.9rem;
    color: var(--text-dim);
    font-style: italic;
  }

  @media (max-width: 900px) {
    .fp-wrapper {
      padding: 4rem 2.5rem;
    }
    .fp-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }
</style>

