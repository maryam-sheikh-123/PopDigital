---
---
<section class="section-starting-points" id="starting-points">
  <div class="container relative z-10">
    <div class="sp-layout">
      
      <!-- Left Column: Title -->
      <div class="sp-title-col">
        <h2 class="sp-title">You don't need a complete website concept yet.</h2>
        <div class="sp-subtitle-line"></div>
        <p class="sp-desc">
          Maybe you're starting from scratch. Maybe you already have a logo, a domain, or your first materials. Or maybe you want to replace a temporary website with a well-thought-out solution.
        </p>
      </div>

      <!-- Right Column: Grid Cards -->
      <div class="sp-cards-col">
        
        <!-- Card 1 -->
        <div class="sp-card bg-card-1">
          <div class="sp-card-icon-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
            </svg>
          </div>
          <h3 class="sp-card-title">Start from scratch</h3>
          <p class="sp-card-text">
            We build the content base, visual identity and technical foundation.
          </p>
          <div class="sp-card-footer">
            <span class="step-num">01 / STRATEGY</span>
            <div class="step-arrow">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="sp-card bg-card-2 text-white">
          <div class="sp-card-icon-pill icon-white">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
          </div>
          <h3 class="sp-card-title text-white">There are the first elements</h3>
          <p class="sp-card-text text-white-alpha">
            Verificăm ce poate fi utilizat și ce trebuie completat sau îmbunătățit.
          </p>
          <div class="sp-card-footer">
            <span class="step-num text-white-alpha">02 / CONTENT</span>
            <div class="step-arrow arrow-white">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            </div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="sp-card bg-card-3">
          <div class="sp-card-icon-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 2v6h-6"></path>
              <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
              <path d="M3 22v-6h6"></path>
              <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
            </svg>
          </div>
          <h3 class="sp-card-title">Înlocuiți o soluție provizorie</h3>
          <p class="sp-card-text">
            Clarificăm ce s-a dovedit util și ce trebuie să ofere mai bine noua prezență.
          </p>
          <div class="sp-card-footer">
            <span class="step-num">03 / UPGRADE</span>
            <div class="step-arrow">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .section-starting-points {
    position: relative;
    padding: 6rem 0;
    background: #f8fafc;
  }
  
  .sp-layout {
    display: grid;
    grid-template-columns: 350px 1fr;
    gap: 4rem;
    align-items: center;
  }
  
  .sp-title-col {
    position: sticky;
    top: 100px;
  }
  
  .sp-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    color: var(--brand-navy);
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .sp-subtitle-line {
    width: 3px;
    height: 40px;
    background: #10b981; /* green brand equivalent */
    margin-bottom: 1rem;
  }
  
  .sp-desc {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .sp-cards-col {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .sp-card {
    padding: 2.5rem;
    border-radius: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    transition: transform 0.3s ease;
  }
  
  .sp-card:hover {
    transform: translateY(-5px);
  }

  .bg-card-1 {
    background-color: #ffffff;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }

  .bg-card-2 {
    background-color: #10b981; /* distinct green emphasis */
    color: #fff;
    box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.4);
  }

  .bg-card-3 {
    background-color: #ffffff;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }

  .sp-card-icon-pill {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #10b981;
    margin-bottom: 2rem;
  }
  
  .icon-white {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }

  .sp-card-icon-pill svg {
    width: 20px;
    height: 20px;
  }

  .sp-card-title {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--brand-navy);
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  
  .sp-card-text {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 3rem;
  }

  .text-white { color: #ffffff !important; }
  .text-white-alpha { color: rgba(255, 255, 255, 0.8) !important; }

  .sp-card-footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(0,0,0,0.05);
    padding-top: 1rem;
  }
  
  .bg-card-2 .sp-card-footer {
    border-top-color: rgba(255,255,255,0.2);
  }

  .step-num {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }

  .step-arrow {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
  }

  .arrow-white {
    border-color: rgba(255,255,255,0.3);
    color: #ffffff;
  }

  @media (max-width: 1100px) {
    .sp-layout {
      grid-template-columns: 1fr;
    }
    .sp-title-col {
      position: relative;
      top: 0;
      text-align: center;
      max-width: 800px;
      margin: 0 auto;
    }
    .sp-subtitle-line {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .sp-cards-col {
      grid-template-columns: 1fr;
    }
  }
</style>
