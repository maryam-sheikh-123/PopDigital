---
---
<section class="section-timeline-vertical" id="vorgehen">
  <div class="container relative z-10">
    <div class="process-header">
      <h2 class="process-title">Cum prinde viata noua prezenta a companiei tale.</h2>
      <p class="process-subtitle">
        If you're ready to take the first step, we offer an intuitive process for small businesses to build their online presence.
      </p>
    </div>

    <div class="timeline-wrapper">
      
      <!-- Center Dashed Line -->
      <div class="timeline-axis"></div>

      <!-- Step 1 -->
      <div class="timeline-step">
        <div class="step-mockup-col">
          <div class="mockup-card">
            <!-- UI Mockup 1: Browser Window -->
            <div class="mockup-browser">
              <div class="browser-header">
                <span></span><span></span><span></span>
              </div>
              <div class="browser-body">
                <div class="mockup-search-bar">
                  <div class="search-input"></div>
                  <div class="search-btn"></div>
                </div>
                <div class="mockup-hero">
                  <div class="hero-circle"></div>
                  <div class="hero-lines">
                    <div class="line w-full"></div>
                    <div class="line w-3/4"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="step-number-col">
          <div class="step-number">1</div>
        </div>
        <div class="step-content-col">
          <h3 class="step-title">Setam obiectivele</h3>
          <p class="step-desc">Clarificam cine si ce ar trebui sa fie atins prin noul website.</p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="timeline-step alt-layout">
        <div class="step-content-col text-right">
          <h3 class="step-title">Dezvoltam baza</h3>
          <p class="step-desc">Organizam mesajele, continutul, structura si directia vizuala generala.</p>
        </div>
        <div class="step-number-col">
          <div class="step-number">2</div>
        </div>
        <div class="step-mockup-col">
          <div class="mockup-card">
            <!-- UI Mockup 2: Design Editor -->
            <div class="mockup-editor">
              <div class="editor-sidebar">
                <div class="line"></div>
                <div class="line"></div>
                <div class="line"></div>
              </div>
              <div class="editor-main">
                <div class="mock-img-box bg-green-400"></div>
                <div class="mock-img-box bg-blue-400 mt-2"></div>
              </div>
              <!-- Floating connected element -->
              <div class="floating-node">
                <div class="node-circle bg-green-500">+</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="timeline-step">
        <div class="step-mockup-col">
          <div class="mockup-card">
            <!-- UI Mockup 3: Person working -->
            <div class="mockup-person">
              <img src="/images/gabriel-antonio-pop.png" alt="Gabriel Pop" class="person-img" style="border-radius:12px;">
              <div class="mockup-badge">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <span>Structurat</span>
              </div>
            </div>
          </div>
        </div>
        <div class="step-number-col">
          <div class="step-number bg-brand-purple">3</div>
        </div>
        <div class="step-content-col">
          <h3 class="step-title">Determinam incluziunile</h3>
          <p class="step-desc">Convenim asupra serviciilor, responsabilitatilor si cerintelor de aprobare.</p>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="timeline-step alt-layout">
        <div class="step-content-col text-right">
          <h3 class="step-title">Design si dezvoltare</h3>
          <p class="step-desc">Cream continutul si implementarea tehnica in etape coordonate strans.</p>
        </div>
        <div class="step-number-col">
          <div class="step-number bg-brand-navy">4</div>
        </div>
        <div class="step-mockup-col">
          <div class="mockup-card">
            <!-- UI Mockup 4: Launch Rocket -->
            <div class="mockup-browser">
              <div class="browser-header">
                <span></span><span></span><span></span>
              </div>
              <div class="browser-body text-center flex flex-col items-center justify-center">
                <div class="launch-check bg-green-500">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <div class="launch-text">Your website is live!</div>
                <div class="launch-btn bg-brand-navy">GO LIVE</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 5 -->
      <div class="timeline-step">
        <div class="step-mockup-col">
          <div class="mockup-card">
            <!-- UI Mockup 5: Analytics -->
            <div class="mockup-browser">
              <div class="browser-header">
                <span></span><span></span><span></span>
              </div>
              <div class="browser-body">
                <div class="stats-grid">
                  <div class="stat-box">
                    <div class="stat-lbl">Visitors</div>
                    <div class="stat-val">12.5K</div>
                  </div>
                  <div class="stat-box">
                    <div class="stat-lbl">Page Views</div>
                    <div class="stat-val">32.8K</div>
                  </div>
                  <div class="stat-box">
                    <div class="stat-lbl">Leads</div>
                    <div class="stat-val">2.6K</div>
                  </div>
                </div>
                <div class="chart-line">
                  <svg viewBox="0 0 100 30" preserveAspectRatio="none">
                    <path d="M0,20 Q10,10 20,25 T40,15 T60,25 T80,5 T100,20" fill="none" stroke="var(--brand-purple)" stroke-width="3"/>
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="step-number-col">
          <div class="step-number bg-brand-navy">5</div>
        </div>
        <div class="step-content-col">
          <h3 class="step-title">Verificam si predam</h3>
          <p class="step-desc">Testam elementele agreate, publicam site-ul si predam documentatia.</p>
        </div>
      </div>

    </div>

    <div class="text-center mt-16">
      <p class="text-muted mb-6">Gabriel Pop conduce personal proiectul, de la prima discutie pana la predare.</p>
      <a href="/projekt-anfragen/" class="btn-primary">GET STARTED</a>
    </div>
  </div>
</section>

<style>
  .section-timeline-vertical {
    padding: 6rem 0 8rem;
    background: #eff6ff; /* light blue background like reference */
    position: relative;
    overflow: hidden;
  }
  
  .process-header {
    text-align: center;
    margin-bottom: 5rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .process-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--brand-navy);
    line-height: 1.15;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .process-subtitle {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .timeline-wrapper {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
  }

  .timeline-axis {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    background-image: linear-gradient(to bottom, #94a3b8 50%, transparent 50%);
    background-size: 2px 12px; /* dashed line */
    z-index: 1;
  }

  .timeline-step {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4rem;
    position: relative;
    z-index: 10;
  }
  
  .timeline-step:last-child {
    margin-bottom: 0;
  }

  .step-mockup-col, .step-content-col {
    width: calc(50% - 40px); /* leaving room for number circle */
  }

  .step-number-col {
    width: 80px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .step-number {
    width: 44px;
    height: 44px;
    background: #4f46e5; /* indigo matching ref */
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.25rem;
    box-shadow: 0 0 0 6px #eff6ff; /* border match bg */
  }

  .bg-brand-purple { background-color: var(--brand-purple) !important; }
  .bg-brand-navy { background-color: var(--brand-navy) !important; }

  .step-title {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--brand-navy);
    margin-bottom: 0.5rem;
  }

  .step-desc {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Text Alignment overrides */
  .text-right { text-align: right; }
  .text-center { text-align: center; }

  /* Mockup Cards */
  .mockup-card {
    background: transparent;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .alt-layout .mockup-card {
    justify-content: flex-start;
  }

  .mockup-browser {
    width: 100%;
    max-width: 300px;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
    border: 1px solid #e2e8f0;
    overflow: hidden;
  }

  .browser-header {
    height: 24px;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    padding: 0 10px;
    gap: 4px;
    border-bottom: 1px solid #e2e8f0;
  }
  .browser-header span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #cbd5e1;
  }
  .browser-header span:nth-child(1) { background: #ef4444; }
  .browser-header span:nth-child(2) { background: #eab308; }
  .browser-header span:nth-child(3) { background: #22c55e; }

  .browser-body {
    padding: 1rem;
    height: 150px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Mockup Elements */
  .mockup-search-bar {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .search-input {
    flex: 1;
    height: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
  }
  .search-btn {
    width: 32px;
    height: 24px;
    background: #cbd5e1;
    border-radius: 4px;
  }
  
  .mockup-hero {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .hero-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #d8b4fe;
  }
  .hero-lines {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .line { height: 8px; background: #e2e8f0; border-radius: 4px; }
  .w-full { width: 100%; }
  .w-3\/4 { width: 75%; }

  .mockup-editor {
    display: flex;
    width: 250px;
    height: 150px;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
    position: relative;
    padding: 0.5rem;
  }
  .editor-sidebar {
    width: 30%;
    border-right: 1px solid #f1f5f9;
    padding-right: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .editor-sidebar .line { height: 6px; }
  .editor-main {
    width: 70%;
    padding-left: 0.5rem;
  }
  .mock-img-box {
    width: 100%;
    height: 40px;
    border-radius: 6px;
  }
  .bg-green-400 { background: #4ade80; }
  .bg-blue-400 { background: #60a5fa; }
  .floating-node {
    position: absolute;
    right: -15px;
    bottom: 20px;
  }
  .node-circle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
  }
  .bg-green-500 { background: #22c55e; }

  .mockup-person {
    position: relative;
    width: 200px;
  }
  .person-img { width: 100%; }
  .mockup-badge {
    position: absolute;
    bottom: -15px;
    left: -15px;
    background: white;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--brand-navy);
  }
  .mockup-badge svg { color: #3b82f6; }

  .launch-check {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }
  .launch-text {
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }
  .launch-btn {
    padding: 0.4rem 1rem;
    color: white;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.75rem;
  }

  .stats-grid {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .stat-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.25rem 0.5rem;
    text-align: center;
  }
  .stat-lbl {
    font-size: 0.5rem;
    color: #64748b;
    text-transform: uppercase;
  }
  .stat-val {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--brand-navy);
  }
  .chart-line {
    width: 100%;
    height: 40px;
  }
  .chart-line svg {
    width: 100%;
    height: 100%;
  }

  .btn-primary {
    background: #4f46e5;
    color: white;
    padding: 1rem 2.5rem;
    border-radius: 50px;
    font-family: var(--font-heading);
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s ease;
  }
  .btn-primary:hover {
    background: #4338ca;
  }
  .text-muted { color: #64748b; }

  /* Mobile */
  @media (max-width: 768px) {
    .timeline-axis {
      left: 30px;
    }
    .timeline-step {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 3rem;
    }
    .alt-layout {
      flex-direction: column;
    }
    .step-mockup-col, .step-content-col {
      width: 100%;
      padding-left: 70px;
    }
    .step-number-col {
      position: absolute;
      left: 0;
      top: 0;
      width: 60px;
    }
    .step-number {
      width: 40px;
      height: 40px;
    }
    .text-right { text-align: left; }
    .step-mockup-col { margin-top: 1rem; }
    .alt-layout .step-mockup-col { margin-top: 1rem; order: 3; }
    .alt-layout .step-content-col { order: 2; }
    .alt-layout .step-number-col { order: 1; }
  }
</style>
