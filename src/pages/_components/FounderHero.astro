            </a>
          </div>
        </div>

        <!-- Right Column: Asymmetric Soft Lavender Backdrop & Portrait (Exact Match to New Reference Screenshot) -->
        <div class="founder-badge-wrapper">
          <div class="founder-dot-grid"></div>
          <div class="founder-backdrop-shape"></div>
          <div class="founder-portrait-container">
            <img src="/images/gabriel-antonio-pop.png" alt="Gabriel Antonio Pop" class="founder-portrait-img">
          </div>
        </div>
      </div>
    </div>
  </section>
