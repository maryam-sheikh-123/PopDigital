<section class="section-founder-hero" id="uber-uns">
    <div class="container">
      <div class="founder-hero-grid">
        <!-- Left Column: Headline, Bio & CTAs -->
        <div class="founder-hero-left">
          <span class="weroast-badge-pill" style="margin-bottom: 1rem; background: #ffffff; color: #475569; border-color: #cbd5e1;">Persönlich
            geführt</span>
          <h2 class="founder-hero-title">
            Ihr Ansprechpartner<br>
            <span class="highlight-purple-text">Gabriel Antonio Pop</span>
          </h2>
          <p class="founder-hero-desc">
            Gabriel Antonio Pop ist Gründer und Inhaber von Pop Digital Solutions e.U. Er führt jedes Projekt
            persönlich, behält Ziele, Zuständigkeiten und Entscheidungen im Blick und bleibt für Sie direkt erreichbar.
          </p>
          <p class="founder-hero-desc" style="margin-top: 0.75rem;">
            Unser Team vereint Kompetenzen aus Entwicklung, Design, Marketing und Produktion. Welche Fachbereiche
            beteiligt sind, richtet sich nach dem Projekt.
          </p>

          <div class="founder-contact-meta">
            <a href="https://maps.google.com/?q=Buchenstra%C3%9Fe+17/3,+4481+Asten" target="_blank" class="meta-item-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8675A1" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Buchenstraße 17/3 · 4481 Asten, Österreich</span>
            </a>
            <a href="tel:+436705515177" class="meta-item-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8675A1" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                </path>
              </svg>
              <span>+43 670 5515177</span>
            </a>
            <a href="mailto:office@popdigital.at" class="meta-item-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8675A1" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>office@popdigital.at</span>
            </a>
          </div>

          <div class="founder-hero-ctas">
            <button type="button" class="btn-founder-primary open-modal-btn">
              <span>Gabriel und Pop Digital Solutions kennenlernen</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </button>
            <a href="https://wa.me/436705515177" target="_blank" class="btn-founder-secondary">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z">
                </path>
