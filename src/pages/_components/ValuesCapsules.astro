---
---
<section class="section-capsule-values">
    <div class="container">
      <!-- Header Grid (Title Left, Desc + Button Right) -->
      <div class="capsule-header-grid">
        <div>
          <span class="weroast-badge-pill" style="margin-bottom: 0.75rem;">Aufeinander abgestimmt</span>
          <h2 class="capsule-title">
            Nicht möglichst viele Leistungen.<br>Die richtigen für Ihr Ziel.
          </h2>
        </div>
        <div class="capsule-header-right">
          <p class="capsule-header-desc">
            Nicht jedes Projekt braucht alles, was wir anbieten. Wir beginnen mit Ihrem Unternehmen, Ihrer Ausgangslage
            und dem Ergebnis, das Sie erreichen möchten.
          </p>
          <a href="/projekt-anfragen/" class="btn-weroast-primary" style="text-decoration:none;">
            <span>Projekt anfragen</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Capsule Rows List (Left: Text Content, Right: Vertically Smaller Capsule Pill) -->
      <div class="capsule-rows-list">
        <!-- Row 1: Konzept -->
        <div class="capsule-row">
          <div class="capsule-row-left">
            <span class="capsule-step-label">Step 1</span>
            <div class="capsule-row-title-wrap">
              <h3 class="capsule-row-title">Gemeinsame Grundlage</h3>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="capsule-title-arrow">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
            <p class="capsule-row-desc">
              Ziele, Zielgruppen und zentrale Botschaften werden geklärt, bevor Gestaltung, Technik oder Produktion
              beginnen.
            </p>
          </div>
          <div>
            <div class="capsule-pill-wrapper">
              <img src="/images/download.jpg" alt="Strategie &amp; Briefing" class="capsule-showcase-img">
              <div class="capsule-overlay-badge">Zieldokument</div>
            </div>
          </div>
        </div>

        <!-- Row 2: Design -->
        <div class="capsule-row">
          <div class="capsule-row-left">
            <span class="capsule-step-label">Step 2</span>
            <div class="capsule-row-title-wrap">
              <h3 class="capsule-row-title">Modern &amp; Individuell</h3>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="capsule-title-arrow">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
            <p class="capsule-row-desc">
              Maßgeschneiderter visueller Auftritt, der perfekt zu Ihrer Marke passt und Vertrauen bei Ihren Kunden
              aufbaut.
            </p>
          </div>
          <div>
            <div class="capsule-pill-wrapper">
              <img src="/images/download (1).jpg" alt="UI/UX &amp; Design" class="capsule-showcase-img">
              <div class="capsule-overlay-badge">UI Layout</div>
            </div>
          </div>
        </div>

        <!-- Row 3: Technik -->
        <div class="capsule-row">
          <div class="capsule-row-left">
            <span class="capsule-step-label">Step 3</span>
            <div class="capsule-row-title-wrap">
              <h3 class="capsule-row-title">Sauber &amp; Zuverlässig</h3>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="capsule-title-arrow">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
            <p class="capsule-row-desc">
              Zukunftssichere, schnelle und 100% DSGVO-konforme Basis ohne unnötige Komplexität oder Ballast.
            </p>
          </div>
          <div>
            <div class="capsule-pill-wrapper">
              <img src="/images/download (2).jpg" alt="High Speed &amp; Performance" class="capsule-showcase-img">
              <div class="capsule-overlay-badge" style="background: rgba(37, 99, 235, 0.9);">Code Ready</div>
            </div>
          </div>
        </div>

        <!-- Row 4: Betreuung -->
        <div class="capsule-row">
          <div class="capsule-row-left">
            <span class="capsule-step-label">Step 4</span>
            <div class="capsule-row-title-wrap">
              <h3 class="capsule-row-title">Persönlich vor Ort</h3>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="capsule-title-arrow">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
            <p class="capsule-row-desc">
              Direkter Ansprechpartner (Gabriel Pop) &amp; schnelle Unterstützung für Ihr Unternehmen in Österreich.
            </p>
          </div>
          <div>
            <div class="capsule-pill-wrapper">
              <img src="/images/download (3).jpg" alt="Gabriel Pop Betreuung" class="capsule-showcase-img">
              <div class="capsule-overlay-badge" style="background: rgba(22, 163, 74, 0.9);">Vor Ort</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

