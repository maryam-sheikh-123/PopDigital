---
---
<section class="section-hero-split" id="hero">
  <div class="container hero-container">
    <div class="hero-split-grid">
      <!-- Left Column: Content & Trust -->
      <div class="hero-split-left">
        <div class="hero-austria-pill">
          <span class="austria-flag-icon">
            <svg width="18" height="13" viewBox="0 0 18 13" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="18" height="13" rx="2" fill="#EF4444"/>
              <rect y="4.33" width="18" height="4.34" fill="#FFFFFF"/>
            </svg>
          </span>
          <span>Für Unternehmen in Österreich · persönlich geführt aus Oberösterreich</span>
        </div>

        <h1 class="hero-split-title">
          Ein Ansprechpartner<br class="hero-title-br" /> für Websites,<br class="hero-title-br" /> Marketing &amp; Design,<br class="hero-title-br" /> digitale Lösungen und<br class="hero-title-br" /> Firmenausstattung.
        </h1>

        <p class="hero-split-desc">
          Pop Digital Solutions verbindet digitale, kreative und praktische Leistungen dort, wo sie gemeinsam gebraucht werden. Gabriel Antonio Pop führt Ihr Projekt persönlich und bleibt vom ersten Gespräch bis zur Übergabe Ihre zentrale Ansprechperson.
        </p>

        <div class="hero-split-ctas">
          <button type="button" class="btn-hero-dark open-modal-btn">
            <span>Projekt anfragen</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </button>
          <a href="/leistungen.html" class="btn-hero-light">
            <span>Lösungen entdecken</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Gabriel Pop at desk with laptop, circular backdrop, dot grid & floating cards -->
      <div class="hero-split-right">
        <div class="hero-visual-wrapper">
          <!-- 6x4 Dot Grid Pattern Matrix (Top Left) -->
          <div class="hero-dot-grid">
            <svg width="90" height="58" viewBox="0 0 90 58" fill="none" xmlns="http://www.w3.org/2000/svg">
              <g fill="#A855F7" opacity="0.4">
                <circle cx="6" cy="6" r="2.2" />
                <circle cx="22" cy="6" r="2.2" />
                <circle cx="38" cy="6" r="2.2" />
                <circle cx="54" cy="6" r="2.2" />
                <circle cx="70" cy="6" r="2.2" />
                <circle cx="86" cy="6" r="2.2" />

                <circle cx="6" cy="22" r="2.2" />
                <circle cx="22" cy="22" r="2.2" />
                <circle cx="38" cy="22" r="2.2" />
                <circle cx="54" cy="22" r="2.2" />
                <circle cx="70" cy="22" r="2.2" />
                <circle cx="86" cy="22" r="2.2" />

                <circle cx="6" cy="38" r="2.2" />
                <circle cx="22" cy="38" r="2.2" />
                <circle cx="38" cy="38" r="2.2" />
                <circle cx="54" cy="38" r="2.2" />
                <circle cx="70" cy="38" r="2.2" />
                <circle cx="86" cy="38" r="2.2" />

                <circle cx="6" cy="54" r="2.2" />
                <circle cx="22" cy="54" r="2.2" />
                <circle cx="38" cy="54" r="2.2" />
                <circle cx="54" cy="54" r="2.2" />
                <circle cx="70" cy="54" r="2.2" />
                <circle cx="86" cy="54" r="2.2" />
              </g>
            </svg>
          </div>


          <!-- Ambient circular glow behind Gabriel -->
          <div class="hero-circle-ambient-glow"></div>
          <!-- Subtle circle outline ring -->
          <div class="hero-circle-backdrop"></div>

          <!-- Main Hero Graphic: Gabriel Pop at Desk — in circle frame -->
          <div class="hero-visual-image-container">
            <div class="hero-img-circle">
              <img 
                src="/images/hero-gabriel-office.jpg" 
                alt="Gabriel Pop - Pop Digital Solutions" 
                class="hero-gabriel-main-img" 
                width="650"
                height="488"
              />
            </div>
          </div>

          <!-- Floating Card 1: Top Right — Digitale Lösungen -->
          <div class="hero-floating-card card-top-right">
            <div class="floating-card-icon icon-purple">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </div>
            <div class="floating-card-text">
              <strong>Digitale Lösungen</strong>
              <span>Effizient. Automatisiert. Zukunftssicher.</span>
            </div>
          </div>

          <!-- Floating Feature Card 2: Mid Left (Marketing & Design) -->
          <div class="hero-floating-card card-mid-left">
            <div class="floating-card-icon icon-purple">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
                <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
                <path d="M2 2l7.586 7.586"></path>
                <circle cx="11" cy="11" r="2"></circle>
              </svg>
            </div>
            <div class="floating-card-text">
              <strong>Marketing &amp; Design</strong>
              <span>Strategisch. Kreativ. Wirksam.</span>
            </div>
          </div>

          <!-- Floating Card 3: Bottom Right — Firmenausstattung -->
          <div class="hero-floating-card card-bottom-right">
            <div class="floating-card-icon icon-purple">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                <path d="M8 21h8M12 17v4"></path>
              </svg>
            </div>
            <div class="floating-card-text">
              <strong>Firmenausstattung</strong>
              <span>Logo. Visitenkarten. Corporate Identity.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
