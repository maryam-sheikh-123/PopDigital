---
---
<section class="section-weroast-configurator" id="pakete">
    <div class="container">
      <div class="config-dark-container" style="grid-template-columns: 1fr 1.85fr;">
        <!-- Left Side Column (Headline & Glowing Bottom Arrow) -->
        <div class="config-dark-left">
          <div>
            <span class="config-dark-badge">● Aufeinander abgestimmt</span>
            <h2 class="config-dark-headline" style="font-size: clamp(1.65rem, 2.2vw, 2.2rem); line-height: 1.18; text-transform: none; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.75rem;">
              <span>Nicht möglichst viele</span><br>
              <span style="white-space: nowrap;">Leistungen. Die richtigen</span><br>
              <span>für Ihr Ziel.</span>
            </h2>
            <p class="config-dark-sub">
              Nicht jedes Projekt braucht alles, was wir anbieten. Wir beginnen mit Ihrem Unternehmen, Ihrer Ausgangslage und dem Ergebnis, das Sie erreichen möchten.
            </p>
          </div>

          <!-- Bottom Left Arrow Icon (Exact Match to Screenshot) -->
          <svg class="config-dark-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </div>

        <!-- Right Side 2x2 Seamless Grid (Tall Cards with Alternating Greyish & Black Fills) -->
        <div class="config-dark-grid-stack">
          <!-- Card 1: Gemeinsame Grundlage -->
          <div class="config-dark-card grey-card">
            <div class="config-dark-icon-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 13V2l8 4-8 4"/><path d="M20.55 10.23A9 9 0 1 1 8 4.94"/><path d="M8 10a5 5 0 1 0 8.9 2.02"/>
              </svg>
            </div>
            <div>
              <h3 class="config-dark-card-title">Gemeinsame Grundlage</h3>
              <p class="config-dark-card-desc">
                Ziele, Zielgruppen und zentrale Botschaften werden geklärt, bevor Gestaltung, Technik oder Produktion beginnen.
              </p>
            </div>
          </div>

          <!-- Card 2: Nachvollziehbarer Umfang -->
          <div class="config-dark-card black-card">
            <div class="config-dark-icon-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/>
              </svg>
            </div>
            <div>
              <h3 class="config-dark-card-title">Nachvollziehbarer Umfang</h3>
              <p class="config-dark-card-desc">
                Sie wissen, welche Leistungen dazugehören, welche Unterlagen benötigt werden und welche Entscheidungen bei Ihnen liegen.
              </p>
            </div>
          </div>

          <!-- Card 3: Abgestimmte Fachbereiche -->
          <div class="config-dark-card grey-card">
            <div class="config-dark-icon-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect width="7" height="7" x="14" y="3" rx="1"/><path d="M10 21V8a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1H3"/>
              </svg>
            </div>
            <div>
              <h3 class="config-dark-card-title">Abgestimmte Fachbereiche</h3>
              <p class="config-dark-card-desc">
                Inhalte, Design, Entwicklung, Marketing und Ausstattung werden verbunden, soweit sie Teil des Projekts sind.
              </p>
            </div>
          </div>

          <!-- Card 4: Geregelte Übergabe -->
          <div class="config-dark-card black-card">
            <div class="config-dark-icon-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/><path d="m9 13 2 2 4-4"/>
              </svg>
            </div>
            <div>
              <h3 class="config-dark-card-title">Geregelte Übergabe</h3>
              <p class="config-dark-card-desc">
                Vereinbarte Zugänge, Daten, Nutzungsrechte und offene Punkte werden nachvollziehbar übergeben.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="config-dark-footer">
        <a href="/projekt-anfragen/" class="btn-circular-cta" style="text-decoration:none;">
          <span>PROJEKT ANFRAGEN ➔</span>
        </a>
      </div>
    </div>
  </section>

