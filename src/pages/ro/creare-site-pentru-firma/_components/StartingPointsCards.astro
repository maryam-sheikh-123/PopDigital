---
---
<section class="section-starting-points" id="starting-points">
  <div class="container relative z-10">
    <div class="sp-header">
      <h2 class="sp-title">You don't need a complete website concept yet.</h2>
      <p class="sp-desc">
        Maybe you're starting from scratch. Maybe you already have a logo, a domain, or your first materials. Or maybe you want to replace a temporary website with a well-thought-out solution.
      </p>
    </div>

    <div class="sp-cards-grid">
      <!-- Card 1 -->
      <div class="sp-card card-tall bg-off-white">
        <div class="sp-card-icon text-brand-purple">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
          </svg>
        </div>
        <h3 class="sp-card-title">Start from scratch</h3>
        <p class="sp-card-text">
          We build the content base, visual identity and technical foundation.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="sp-card card-short bg-white">
        <div class="sp-card-icon text-brand-navy">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="3" y1="9" x2="21" y2="9"></line>
            <line x1="9" y1="21" x2="9" y2="9"></line>
          </svg>
        </div>
        <h3 class="sp-card-title">There are the first elements</h3>
        <p class="sp-card-text">
          Verificăm ce poate fi utilizat și ce trebuie completat sau îmbunătățit.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="sp-card card-wide bg-off-white">
        <div class="sp-card-icon text-brand-purple">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 2v6h-6"></path>
            <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
            <path d="M3 22v-6h6"></path>
            <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
          </svg>
        </div>
        <h3 class="sp-card-title">Înlocuiți o soluție provizorie</h3>
        <p class="sp-card-text">
          Clarificăm ce s-a dovedit util și ce trebuie să ofere mai bine noua prezență.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .section-starting-points {
    position: relative;
    padding: 8rem 0 4rem;
    background: var(--brand-navy); /* Using brand theme color for the solid background */
    overflow: hidden;
  }
  
  .sp-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 5rem;
  }
  
  .sp-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .sp-desc {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
    max-width: 650px;
    margin: 0 auto;
  }

  .sp-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
    align-items: start;
  }

  /* Masonry / Asymmetric style layout */
  .card-tall {
    min-height: 380px;
  }
  
  .card-short {
    min-height: 320px;
    margin-top: 3rem; /* Staggered effect */
  }

  .card-wide {
    grid-column: 1 / -1;
    min-height: 320px;
    max-width: 800px;
    margin: 0 auto;
    width: 100%;
  }

  .sp-card {
    padding: 3.5rem 3rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    /* Chamfered corners using clip-path */
    clip-path: polygon(
      30px 0, 
      calc(100% - 30px) 0, 
      100% 30px, 
      100% calc(100% - 30px), 
      calc(100% - 30px) 100%, 
      30px 100%, 
      0 calc(100% - 30px), 
      0 30px
    );
    transition: transform 0.3s ease;
  }
  
  .sp-card:hover {
    transform: translateY(-5px);
  }

  .bg-white {
    background-color: #ffffff;
  }

  .bg-off-white {
    background-color: #fcfafc;
  }

  .sp-card-icon {
    margin-bottom: 2.5rem;
  }
  
  .sp-card-icon svg {
    width: 36px;
    height: 36px;
  }

  .sp-card-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--brand-navy);
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  
  .sp-card-text {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    font-weight: 500;
  }

  .text-brand-purple { color: var(--brand-purple); }
  .text-brand-navy { color: var(--brand-navy); }

  @media (max-width: 900px) {
    .sp-cards-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .card-short {
      margin-top: 0;
    }
    
    .sp-card {
      min-height: auto;
      padding: 2.5rem 2rem;
    }
  }
</style>
