</section>

<style>
  .section-deliverables {
    padding: 2rem 0 3rem;
    background: #ffffff;
    font-family: 'Inter', system-ui, sans-serif;
  }
  
  .del-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 4rem;
  }
  
  .del-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    color: var(--brand-navy);
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
  }
  
  .del-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    font-weight: 400;
  }

  .pricing-card-dark {
    background: var(--brand-navy);
    border-radius: 24px;
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    box-shadow: 0 30px 60px rgba(26, 47, 84, 0.15);
    overflow: hidden;
  }

  .card-left {
    flex: 1;
    padding: 4rem;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .left-title {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 3rem;
    letter-spacing: -0.02em;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    flex-grow: 1;
  }

  .features-list li {
    display: flex;
    align-items: flex-start;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .features-list li strong {
    color: #ffffff;
    font-weight: 600;
  }

  .check-circle {
    width: 18px;
    height: 18px;
    color: rgba(255, 255, 255, 0.4);
    margin-right: 1rem;
    flex-shrink: 0;
    margin-top: 3px;
  }

  .bottom-disclaimer {
    margin-top: 4rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.4);
    line-height: 1.5;
  }

  .card-right {
    flex: 0 0 420px;
    padding: 2.5rem 2.5rem 2.5rem 0;
  }

  .inset-box {
    background: linear-gradient(145deg, rgba(105, 83, 138, 0.3) 0%, rgba(26, 47, 84, 0.8) 100%);
    border-radius: 16px;
    height: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1), 0 10px 30px rgba(0,0,0,0.2);
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .toggle-container {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 50px;
    display: flex;
    padding: 4px;
    margin-bottom: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .toggle-btn {
    flex: 1;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.6rem 0;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .toggle-btn.active {
    background: #ffffff;
    color: var(--brand-navy);
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .inset-content {
    margin-top: auto;
    display: flex;
    flex-direction: column;
  }

  .meta-label {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin-bottom: 4rem;
    display: block;
    text-align: center;
  }

  .price-display {
    display: flex;
    align-items: flex-start;
    color: #ffffff;
    margin-bottom: 1.5rem;
  }
  
  .currency {
    font-size: 1.5rem;
    font-weight: 400;
    margin-top: 0.5rem;
    margin-right: 0.2rem;
  }
  
  .price-value {
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    font-family: var(--font-heading);
  }

  .action-btn {
    display: block;
    width: 100%;
    text-align: center;
    background: #ffffff;
    color: var(--brand-navy);
    text-decoration: none;
    padding: 1rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1rem;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .action-btn:hover {
    opacity: 0.9;
    transform: scale(0.98);
  }

  @media (max-width: 900px) {
    .pricing-card-dark {
      flex-direction: column;
    }
    
    .card-left {
      padding: 3rem 2rem;
    }
    
    .card-right {
      flex: none;
      padding: 0 2rem 2rem;
    }
    
    .bottom-disclaimer {
      margin-top: 2rem;
    }

    .meta-label {
      margin-bottom: 2rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtns = document.querySelectorAll('.toggle-btn');
    const featuresBasic = document.getElementById('features-basic');
    const featuresComplete = document.getElementById('features-complete');
    const titleEl = document.getElementById('package-title');
    const priceEl = document.getElementById('price-display');
    const btnEl = document.getElementById('action-btn');

    toggleBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        toggleBtns.forEach(b => b.classList.remove('active'));
        e.target.classList.add('active');

        const target = e.target.getAttribute('data-target');

        if (target === 'basic') {
          titleEl.textContent = 'Pachet de Bază';
          priceEl.textContent = '1,499';
          btnEl.innerHTML = 'Stabilește o discuție ✨';
          featuresBasic.style.display = 'flex';
          featuresComplete.style.display = 'none';
        } else {
          titleEl.textContent = 'Pachet Complet';
          priceEl.textContent = '2,499';
          btnEl.innerHTML = 'Începe proiectul ✨';
          featuresBasic.style.display = 'none';
          featuresComplete.style.display = 'flex';
        }
      });
    });
  });
</script>

