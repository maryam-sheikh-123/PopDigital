---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/common/Header.astro';
import Footer from '../../../components/common/Footer.astro';

import ProfessionalHero from './_components/ProfessionalHero.astro';
import StartingPointsCards from './_components/StartingPointsCards.astro';
import ModularDeliverables from './_components/ModularDeliverables.astro';
import QualityOutcomesGrid from './_components/QualityOutcomesGrid.astro';
import ScopeClarityList from './_components/ScopeClarityList.astro';
import StartProcessTimeline from './_components/StartProcessTimeline.astro';
import PostLaunchOptions from './_components/PostLaunchOptions.astro';
import FinalInquiryAction from './_components/FinalInquiryAction.astro';
---

<Layout 
  title="Website for company in Austria | Pop Digital Solutions" 
  description="We build the company's website and presence from scratch – with clear messages, individual design, modern implementation and Gabriel Pop as your contact person.">
  
  <Header />

  <main>
    <ProfessionalHero />
    <StartingPointsCards />
    <ModularDeliverables />
    <QualityOutcomesGrid />
    <ScopeClarityList />
    <StartProcessTimeline />
    <PostLaunchOptions />
    <FinalInquiryAction />
  </main>

  <Footer />
</Layout>
