---
---
<section class="section-pp-redesign" id="signals">
  <div class="container">
    
    <!-- Top Bio / Introduction Split -->
    <div class="pp-bio-split">
      <div class="pp-bio-text">
        <span class="weroast-badge-pill" style="margin-bottom: 1.25rem;">
          Când website-ul nu mai ține pasul
        </span>
        <h2 class="pp-bio-title">
          Compania dumneavoastră a evoluat. Website-ul trebuie să reflecte această evoluție.
        </h2>
        <p class="pp-bio-desc">
          O relansare poate fi potrivită când sunt valabile mai multe dintre următoarele situații:
        </p>
        <div class="pp-bio-signature">
          "Niciun punct nu înseamnă automat că totul trebuie reconstruit. Tocmai de aceea, relansarea începe cu o evaluare clară."
        </div>
      </div>
      
      <div class="pp-bio-visual">
        <div class="bio-image-wrapper">
          <img src="/images/gabriel-antonio-pop.png" alt="Gabriel Pop" class="bio-image" />
        </div>
      </div>
    </div>

    <!-- Bottom Feature / Benefit Grid -->
    <div class="pp-feature-grid">
      
      <!-- Feature 1 -->
      <div class="pp-feature-item">
        <div class="pp-feature-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
        </div>
        <h3 class="pp-feature-title">Design depășit</h3>
        <p class="pp-feature-text">designul și imaginea publică nu mai corespund companiei;</p>
      </div>
      
      <!-- Feature 2 -->
      <div class="pp-feature-item">
        <div class="pp-feature-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-5a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-5a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        </div>
        <h3 class="pp-feature-title">Evoluția ofertei</h3>
        <p class="pp-feature-text">serviciile, publicul sau poziționarea s-au schimbat;</p>
      </div>

      <!-- Feature 3 -->
      <div class="pp-feature-item">
        <div class="pp-feature-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <h3 class="pp-feature-title">Navigare dificilă</h3>
        <p class="pp-feature-text">conținuturile și opțiunile de contact sunt greu de găsit;</p>
      </div>

      <!-- Feature 4 -->
      <div class="pp-feature-item">
        <div class="pp-feature-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
        </div>
        <h3 class="pp-feature-title">Mobile UX slab</h3>
        <p class="pp-feature-text">experiența pe mobil este slabă;</p>
      </div>

      <!-- Feature 5 -->
      <div class="pp-feature-item">
        <div class="pp-feature-icon">
          <!-- Edit / Pencil Box Icon -->
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
        </div>
        <h3 class="pp-feature-title">Probleme tehnice</h3>
        <p class="pp-feature-text">încărcarea sau calitatea tehnică creează probleme, iar website-ul este greu de întreținut;</p>
      </div>

      <!-- Feature 6 -->
      <div class="pp-feature-item">
        <div class="pp-feature-icon">
          <!-- Gear Icon for CMS -->
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        </div>
        <h3 class="pp-feature-title">CMS limitat</h3>
        <p class="pp-feature-text">conținuturile sunt greu de administrat sau extins;</p>
      </div>

      <!-- Feature 7 -->
      <div class="pp-feature-item">
        <div class="pp-feature-icon">
          <!-- Clipboard List Icon -->
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
        </div>
        <h3 class="pp-feature-title">Procese ineficiente</h3>
        <p class="pp-feature-text">formularele și funcțiile nu mai susțin procesele actuale;</p>
      </div>

      <!-- Feature 8 -->
      <div class="pp-feature-item">
        <div class="pp-feature-icon">
          <!-- Growth Arrow Icon -->
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
        </div>
        <h3 class="pp-feature-title">SEO & Structură</h3>
        <p class="pp-feature-text">structura, URL-urile sau bazele SEO trebuie revizuite.</p>
      </div>

    </div>
  </div>
</section>

<style>
  .section-pp-redesign {
    padding: 4rem 0; /* py-16 */
    background: #ffffff;
    position: relative;
    overflow: hidden;
  }

  /* Bio Split Section */
  .pp-bio-split {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
    margin-bottom: 6rem;
  }

  .pp-bio-text {
    max-width: 650px;
  }

  .pp-bio-title {
    font-family: var(--font-heading, inherit);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    color: var(--brand-navy, #0f172a);
    line-height: 1.15;
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  .pp-bio-desc {
    font-size: 1.15rem;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .pp-bio-signature {
    font-family: 'Caveat', 'Segoe Script', cursive; /* handwritten styling */
    font-size: 1.4rem;
    color: var(--brand-purple, #6366f1);
    line-height: 1.5;
    padding-left: 1.5rem;
    border-left: 2px solid var(--brand-purple, #6366f1);
    opacity: 0.9;
  }

  /* Profile Visual Container */
  .pp-bio-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    padding: 2rem;
  }

  .bio-image-wrapper {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1 / 1;
    background: var(--brand-navy, #0f172a);
    /* Unique blob/frame shape matching reference: Top-Left, Top-Right, Bottom-Right, Bottom-Left */
    border-radius: 2rem 50% 2rem 50%;
    overflow: hidden;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.15);
  }

  .bio-image-wrapper::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top left, rgba(99,102,241,0.25) 0%, transparent 60%);
    z-index: 1;
    pointer-events: none;
  }

  .bio-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 10%; /* Focus on face */
    position: relative;
    z-index: 2;
  }

  /* Bottom Feature Grid */
  .pp-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .pp-feature-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1.5rem; /* rounded-2xl */
    padding: 2.25rem 2rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  
  .pp-feature-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.06);
    border-color: var(--brand-purple, #6366f1);
  }

  .pp-feature-icon {
    width: 60px;
    height: 60px;
    background: #f8fafc; /* generous minimalist container */
    color: var(--brand-purple, #6366f1);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    transition: transform 0.3s ease, background 0.3s ease;
    border: 1px solid #f1f5f9;
  }
  
  .pp-feature-item:hover .pp-feature-icon {
    background: var(--brand-purple, #6366f1);
    color: #ffffff;
    transform: scale(1.05);
  }

  .pp-feature-icon svg {
    width: 28px;
    height: 28px;
    stroke-width: 1.5;
  }

  .pp-feature-title {
    font-family: var(--font-heading, inherit);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--brand-navy, #0f172a);
    margin-bottom: 0.85rem;
    line-height: 1.3;
  }

  .pp-feature-text {
    font-size: 1rem;
    color: #475569;
    line-height: 1.6;
    margin: 0;
  }

  /* Responsive Adjustments */
  @media (max-width: 960px) {
    .pp-bio-split {
      grid-template-columns: 1fr;
      gap: 3rem;
      margin-bottom: 4rem;
    }
    
    .pp-bio-visual {
      padding: 0;
      order: -1;
    }
    
    .bio-image-wrapper {
      max-width: 320px;
    }
    
    .pp-feature-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (min-width: 600px) and (max-width: 960px) {
    .pp-feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
