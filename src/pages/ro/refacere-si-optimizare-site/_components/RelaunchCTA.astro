---
---
<section class="section-relaunch-cta" id="inquiry">
  <div class="container">
    <div class="cta-banner">
      
      <div class="cta-content">
        <span class="weroast-badge-pill" style="margin-bottom: 1.5rem; background: rgba(255,255,255,0.15); color: #ffffff; border-color: rgba(255,255,255,0.3);">
          Următoarea etapă a website-ului
        </span>
        <h2 class="cta-title">
          Ce trebuie să ofere mai bine website-ul dumneavoastră?
        </h2>
        <p class="cta-desc">
          Trimiteți-ne linkul website-ului actual și descrieți ce nu mai corespunde, ce trebuie păstrat și ce doriți să schimbați.
        </p>
        
        <div class="cta-form-area">
          <div class="url-input-group">
            <span class="url-prefix">URL actual:</span>
            <input type="text" placeholder="domeniul-dumneavoastra.ro" class="url-input" readonly />
          </div>
          <a href="/contact/" class="btn-cta-submit">
            Discutați relansarea website-ului
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="cta-trust-col">
        <div class="trust-card">
          <img src="/images/gabriel-antonio-pop.png" alt="Gabriel Pop" class="trust-avatar">
          <div class="trust-info">
            <p class="trust-name">Gabriel Pop</p>
            <p class="trust-role">Consultant principal</p>
          </div>
          <div class="trust-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            Gabriel vă va răspunde personal
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .section-relaunch-cta {
    padding: 6rem 0 8rem;
    background: #ffffff;
  }

  .cta-banner {
    position: relative;
    background: linear-gradient(135deg, var(--brand-navy) 0%, var(--brand-purple) 100%);
    border-radius: var(--radius-xl);
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(105, 83, 138, 0.2);
    align-items: center;
  }

  .cta-content {
    padding: 5rem 4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    z-index: 2;
  }

  .cta-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .cta-desc {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 500px;
  }

  .cta-form-area {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    max-width: 450px;
  }

  .url-input-group {
    display: flex;
    align-items: center;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: var(--radius-md);
    padding: 0.5rem 1rem;
  }

  .url-prefix {
    color: rgba(255,255,255,0.7);
    font-weight: 600;
    margin-right: 0.5rem;
    font-size: 0.95rem;
  }

  .url-input {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 1rem;
    width: 100%;
    outline: none;
  }
  .url-input::placeholder {
    color: rgba(255,255,255,0.4);
  }

  .btn-cta-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: #ffffff;
    color: var(--brand-purple);
    padding: 1rem;
    border-radius: var(--radius-md);
    font-size: 1.05rem;
    font-weight: 700;
    transition: transform 0.2s, box-shadow 0.2s;
    width: 100%;
  }
  
  .btn-cta-submit svg {
    width: 20px;
    height: 20px;
    transition: transform 0.2s;
  }
  
  .btn-cta-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255, 255, 255, 0.2);
  }
  .btn-cta-submit:hover svg {
    transform: translateX(4px);
  }

  .cta-trust-col {
    padding: 4rem;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(0,0,0,0.1);
    height: 100%;
  }

  .trust-card {
    background: #ffffff;
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    text-align: center;
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
  }

  .trust-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    margin: 0 auto 1rem;
    object-fit: cover;
    object-position: center 15%;
    border: 3px solid var(--brand-purple-soft);
  }

  .trust-name {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--brand-navy);
  }

  .trust-role {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ecfdf5;
    color: #059669;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .trust-badge svg {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 960px) {
    .cta-banner {
      grid-template-columns: 1fr;
    }
    
    .cta-content {
      padding: 4rem 2.5rem;
    }
    
    .cta-trust-col {
      padding: 3rem 2.5rem;
    }
  }
</style>
