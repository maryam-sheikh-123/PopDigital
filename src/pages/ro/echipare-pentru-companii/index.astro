import Footer from '../../../components/common/Footer.astro';

import EquipmentHero from './_components/EquipmentHero.astro';
import FitRequirementsChecklist from './_components/FitRequirementsChecklist.astro';
import ProductFamiliesTactile from './_components/ProductFamiliesTactile.astro';
