---
---
<section class="section-hero-split" id="hero">
  <div class="container hero-container">
    <div class="hero-split-grid">
      <!-- Left Column: Content & Trust -->
      <div class="hero-split-left">
        <div class="hero-austria-pill">
          <span class="austria-flag-icon">
            <svg width="18" height="13" viewBox="0 0 18 13" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="18" height="13" rx="2" fill="#EF4444"/>
              <rect y="4.33" width="18" height="4.34" fill="#FFFFFF"/>
            </svg>
          </span>
          <span>Für Unternehmen in Österreich · persönlich geführt aus Oberösterreich</span>
        </div>

        <h1 class="hero-split-title">
          Ein Ansprechpartner für Websites, Marketing &amp; Design, digitale Lösungen und Firmenausstattung.
        </h1>

        <p class="hero-split-desc">
          Pop Digital Solutions verbindet digitale, kreative und praktische Leistungen dort, wo sie gemeinsam gebraucht werden. Gabriel Pop führt Ihr Projekt persönlich und bleibt vom ersten Gespräch bis zur Übergabe Ihre zentrale Ansprechperson.
        </p>

        <div class="hero-split-ctas">
          <button type="button" class="btn-hero-dark open-modal-btn">
            <span>Projekt anfragen</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </button>
          <a href="/leistungen.html" class="btn-hero-light">
            <span>Lösungen entdecken</span>
          </a>
        </div>

        <!-- Trust Rating Avatars -->
        <div class="hero-trust-bar">
          <div class="hero-trust-avatars">
            <img src="/images/gabriel-antonio-pop.png" alt="Gabriel Pop" class="trust-avatar-img" />
            <img src="/images/download (1).jpg" alt="Kunde 1" class="trust-avatar-img" />
            <img src="/images/download (2).jpg" alt="Kunde 2" class="trust-avatar-img" />
          </div>
          <div class="hero-trust-info">
            <div class="hero-trust-stars">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </div>
            <span class="hero-trust-text">Vertrauen von Unternehmen in ganz Österreich</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Gabriel Pop with Laptop & Floating Feature Cards -->
      <div class="hero-split-right">
        <div class="hero-visual-wrapper">
          <!-- Dot Grid Pattern -->
          <div class="hero-dot-grid"></div>

          <!-- Organic Lavender Swoosh Shape Backdrop -->
          <div class="hero-swoosh-backdrop"></div>

          <!-- Curved Accent Path Lines -->
          <svg class="hero-flowing-lines" viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M-50 360 C 120 360, 240 330, 360 260 C 460 200, 480 80, 520 -20" stroke="#8675A1" stroke-width="2" stroke-opacity="0.35" fill="none"/>
            <path d="M-20 400 C 160 400, 280 370, 400 300 C 500 240, 530 140, 550 50" stroke="#69538A" stroke-width="1.5" stroke-opacity="0.25" fill="none"/>
          </svg>

          <!-- Main Portrait Image -->
          <div class="hero-image-container">
            <img 
              src="/images/pop-digital-hero-gabriel-laptop-transparent (2).webp" 
              alt="Gabriel Antonio Pop - Pop Digital Solutions" 
              class="hero-gabriel-img" 
            />
          </div>

          <!-- Floating Feature Card 1: Top Right (Websites & Landingpages) -->
          <div class="hero-floating-card card-top-right">
            <div class="floating-card-icon icon-blue">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </div>
            <div class="floating-card-text">
              <strong>Websites &amp; Landingpages</strong>
              <span>Modern. Schnell. Überzeugend.</span>
            </div>
          </div>

          <!-- Floating Feature Card 2: Mid Left (Marketing & Design) -->
          <div class="hero-floating-card card-mid-left">
            <div class="floating-card-icon icon-purple">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
                <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
                <path d="M2 2l7.586 7.586"></path>
                <circle cx="11" cy="11" r="2"></circle>
              </svg>
            </div>
            <div class="floating-card-text">
              <strong>Marketing &amp; Design</strong>
              <span>Strategisch. Kreativ. Wirksam.</span>
            </div>
          </div>

          <!-- Floating Feature Card 3: Bottom Right (Digitale Lösungen) -->
          <div class="hero-floating-card card-bottom-right">
            <div class="floating-card-icon icon-blue">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </div>
            <div class="floating-card-text">
              <strong>Digitale Lösungen</strong>
              <span>Effizient. Automatisiert. Zukunftssicher.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
