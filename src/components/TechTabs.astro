---
---
<section class="explore-banner-section" id="explore-leistungen">
    <div class="explore-banner-inner">
      <a href="/portfolio" class="explore-banner-card">

        <!-- Left: Arrow + Text -->
        <div class="explore-banner-left">
          <svg class="explore-banner-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
          <div class="explore-banner-text">
            Einblicke in unsere Arbeit<br><span>Pop Digital Solutions Portfolio entdecken</span>
          </div>
        </div>

        <!-- Right: Rich SVG Folder Illustration -->
        <div class="explore-banner-right">
          <div class="explore-folder-wrapper">
            <svg class="explore-folder-illustration" width="130" height="130" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <!-- Shadow Filters -->
                <filter id="folder-shadow" x="-20%" y="-15%" width="140%" height="140%" filterUnits="userSpaceOnUse">
                  <fedropshadow dx="0" dy="8" stdDeviation="6" flood-color="#8675A1" flood-opacity="0.28"></fedropshadow>
                  <fedropshadow dx="0" dy="3" stdDeviation="3" flood-color="#0f172a" flood-opacity="0.15"></fedropshadow>
                </filter>
                <filter id="document-shadow" x="-25%" y="-20%" width="150%" height="150%">
                  <fedropshadow dx="0" dy="5" stdDeviation="4" flood-color="#0F172A" flood-opacity="0.12"></fedropshadow>
                </filter>

                <!-- Folder Back Gradient -->
                <lineargradient id="folder-back-grad" x1="15" y1="25" x2="100" y2="100" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FF9E00"></stop>
                  <stop offset="50%" stop-color="#E85D04"></stop>
                  <stop offset="100%" stop-color="#9D0208"></stop>
                </lineargradient>

                <!-- Folder Front Cover Gradient (Vibrant Gold/Amber to Purple Accent) -->
                <lineargradient id="folder-front-grad" x1="10" y1="45" x2="110" y2="105" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FFD000"></stop>
                  <stop offset="45%" stop-color="#FF9100"></stop>
                  <stop offset="90%" stop-color="#E85D04"></stop>
                </lineargradient>

                <!-- Folder Pocket Gradient -->
                <lineargradient id="folder-pocket-grad" x1="10" y1="50" x2="110" y2="105" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FFEA00"></stop>
                  <stop offset="60%" stop-color="#FF9E00"></stop>
                  <stop offset="100%" stop-color="#D00000"></stop>
                </lineargradient>

                <!-- Card 1 Gradient -->
                <lineargradient id="card-1-grad" x1="25" y1="15" x2="75" y2="70" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FFFFFF"></stop>
                  <stop offset="100%" stop-color="#F1F5F9"></stop>
                </lineargradient>

                <!-- Card 2 (Front Document) Gradient -->
                <lineargradient id="card-2-grad" x1="40" y1="25" x2="90" y2="80" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FFFFFF"></stop>
                  <stop offset="100%" stop-color="#E2E8F0"></stop>
                </lineargradient>

                <!-- Purple Accent Gradient -->
                <lineargradient id="purple-accent-grad" x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#A78BFA"></stop>
                  <stop offset="100%" stop-color="#8675A1"></stop>
                </lineargradient>

                <!-- Sparkle Gold Gradient -->
                <lineargradient id="sparkle-grad" x1="0" y1="0" x2="15" y2="15" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FFE600"></stop>
                  <stop offset="100%" stop-color="#FF9100"></stop>
                </lineargradient>
              </defs>

              <!-- Ambient Glow Circle Background -->
              <circle cx="60" cy="65" r="46" fill="#8675A1" fill-opacity="0.14"></circle>

              <!-- Main Folder Group with Drop Shadow -->
              <g filter="url(#folder-shadow)" class="folder-main-group">
                <!-- 1. Folder Back Body -->
                <path d="M16 38C16 33.5817 19.5817 30 24 30H46C49.1 30 51.8 31.8 53.1 34.5L56.5 41.5C57.4 43.2 59.2 44 61.1 44H96C100.418 44 104 47.5817 104 52V92C104 96.4183 100.418 100 96 100H24C19.5817 100 16 96.4183 16 92V38Z" fill="url(#folder-back-grad)"></path>

                <!-- 2. Back Document / Paper 1 (Sticking out, angled) -->
                <g transform="rotate(-6 50 50)" filter="url(#document-shadow)" class="folder-doc-back">
                  <rect x="30" y="22" width="46" height="60" rx="6" fill="url(#card-1-grad)"></rect>
                  <!-- Lines on Doc 1 -->
                  <rect x="37" y="30" width="22" height="4" rx="2" fill="#8675A1" fill-opacity="0.85"></rect>
                  <rect x="37" y="38" width="32" height="3" rx="1.5" fill="#CBD5E1"></rect>
                  <rect x="37" y="45" width="28" height="3" rx="1.5" fill="#CBD5E1"></rect>
                  <rect x="37" y="52" width="20" height="3" rx="1.5" fill="#E2E8F0"></rect>
                </g>

                <!-- 3. Front Document / Paper 2 (Taller, angled right) -->
                <g transform="rotate(5 65 48)" filter="url(#document-shadow)" class="folder-doc-front">
                  <rect x="44" y="20" width="48" height="62" rx="6" fill="url(#card-2-grad)"></rect>
                  <!-- Header bar on Doc 2 -->
                  <rect x="51" y="27" width="24" height="5" rx="2.5" fill="url(#purple-accent-grad)"></rect>
                  <!-- Decorative Badge / Chart icon on Doc 2 -->
                  <circle cx="81" cy="29.5" r="4.5" fill="#38BDF8"></circle>
                  <!-- Text skeleton lines -->
                  <rect x="51" y="37" width="34" height="3.5" rx="1.75" fill="#94A3B8"></rect>
                  <rect x="51" y="44" width="30" height="3.5" rx="1.75" fill="#CBD5E1"></rect>
                  <rect x="51" y="51" width="34" height="3.5" rx="1.75" fill="#CBD5E1"></rect>
                  <rect x="51" y="58" width="22" height="3.5" rx="1.75" fill="#E2E8F0"></rect>
                </g>

                <!-- 4. Folder Front Pocket / Cover -->
                <path class="folder-front-cover" d="M14 48C14 44.6863 16.6863 42 20 42H48.5C51.1 42 53.5 43.3 54.8 45.6L58.2 51.4C59.3 53.3 61.3 54.5 63.5 54.5H100C103.314 54.5 106 57.1863 106 60.5V90C106 95.5228 101.523 100 96 100H24C18.4772 100 14 95.5228 14 90V48Z" fill="url(#folder-front-grad)"></path>

                <!-- 5. Top Highlight Line on Front Cover -->
                <path d="M20 43.5H48.5C50.6 43.5 52.6 44.5 53.7 46.4L57.1 52.2C58.5 54.6 61 56 63.5 56H100C102.5 56 104.5 58 104.5 60.5" stroke="#FFF" stroke-opacity="0.65" stroke-width="2" stroke-linecap="round"></path>

                <!-- 6. Front Pocket Overlay for Extra 3D Depth -->
                <path d="M14 62C14 62 35 56 65 64C95 72 106 63 106 63V90C106 95.5228 101.523 100 96 100H24C18.4772 100 14 95.5228 14 90V62Z" fill="url(#folder-pocket-grad)" fill-opacity="0.45"></path>
              </g>

              <!-- 7. Decorative Floating Sparkle 1 -->
              <g class="folder-sparkle-1" transform="translate(92, 16)">
                <path d="M6 0L7.6 4.4L12 6L7.6 7.6L6 12L4.4 7.6L0 6L4.4 4.4L6 0Z" fill="url(#sparkle-grad)"></path>
              </g>

              <!-- 8. Decorative Floating Sparkle 2 -->
              <g class="folder-sparkle-2" transform="translate(8, 78)">
                <path d="M4 0L5.1 2.9L8 4L5.1 5.1L4 8L2.9 5.1L0 4L2.9 2.9L4 0Z" fill="#A78BFA"></path>
              </g>

              <!-- 9. Floating Dots -->
              <circle cx="104" cy="38" r="2" fill="#FFD000"></circle>
              <circle cx="10" cy="36" r="2.5" fill="#8675A1"></circle>
            </svg>
          </div>
        </div>

      </a>
    </div>
  </section>
