---
---
<section class="section-process-ribbon" id="vorgehen">
  <div class="container process-container">
    <!-- Header -->
    <div class="process-header-center">
      <span class="process-eyebrow-pill">Klar von Anfang an</span>
      <h2 class="process-ribbon-title">
        So wird aus Ihrem Anliegen<br />
        ein <span class="process-highlight-purple">klar vereinbartes Projekt.</span>
      </h2>
    </div>

    <!-- 3-Circle Gradient Step Rings -->
    <div class="process-ribbon-wrapper">
      <div class="process-cards-flex">
        
        <!-- Step 01: Ausgangslage verstehen -->
        <div class="step-ring-card step-ring-left">
          <div class="step-badge badge-pos-left">01</div>
          <div class="step-card-content">
            <div class="step-icon-wrap">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#1e293b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <line x1="10" y1="9" x2="8" y2="9"></line>
              </svg>
            </div>
            <h3 class="step-card-title">Ausgangslage<br />verstehen</h3>
            <p class="step-card-desc">
              Sie beschreiben, wo Ihr Unternehmen heute steht, was vorhanden ist und was sich verändern soll.
            </p>
          </div>
        </div>

        <!-- Step 02: Ziel und Umfang festlegen (Elevated) -->
        <div class="step-ring-card step-ring-center">
          <div class="step-badge badge-pos-top">02</div>
          <div class="step-card-content">
            <div class="step-icon-wrap">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#1e293b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>
            <h3 class="step-card-title">Ziel und Umfang<br />festlegen</h3>
            <p class="step-card-desc">
              Wir klären Leistungen, Zuständigkeiten, Entscheidungen, Unterlagen sowie den Rahmen.
            </p>
          </div>
        </div>

        <!-- Step 03: Umsetzen, prüfen & übergeben -->
        <div class="step-ring-card step-ring-right">
          <div class="step-badge badge-pos-right">03</div>
          <div class="step-card-content">
            <div class="step-icon-wrap">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#1e293b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
            <h3 class="step-card-title">Umsetzen, prüfen &amp;<br />übergeben</h3>
            <p class="step-card-desc">
              Die Leistungen werden in Etappen umgesetzt, geprüft und nachvollziehbar übergeben.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
