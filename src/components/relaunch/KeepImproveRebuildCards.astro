---
---
<section class="section-kir" id="kir">
  <div class="container">
    <div class="kir-header text-center">
      <span class="weroast-badge-pill" style="margin-bottom: 1.25rem;">
        Păstrăm ceea ce are valoare
      </span>
      <h2 class="kir-title">
        Nu totul trebuie refăcut.
      </h2>
      <p class="kir-desc">
        Conținuturile, paginile, URL-urile, funcțiile și elementele de brand existente pot avea în continuare valoare. Nu preluăm automat totul, dar nici nu eliminăm ceva doar pentru că website-ul este relansat.
      </p>
    </div>

    <div class="kir-flow-container">
      <!-- The Assessment Point -->
      <div class="assessment-node">
        Evaluarea inițială
      </div>

      <!-- The connection paths -->
      <svg class="flow-lines" viewBox="0 0 1000 150" preserveAspectRatio="none">
        <path d="M500,0 C500,75 166,75 166,150" class="flow-path path-keep" />
        <path d="M500,0 C500,75 500,75 500,150" class="flow-path path-improve" />
        <path d="M500,0 C500,75 833,75 833,150" class="flow-path path-rebuild" />
      </svg>

      <!-- The 3 branching columns -->
      <div class="kir-grid">
        
        <div class="kir-card card-keep">
          <div class="kir-icon icon-green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h3 class="kir-card-title">Păstrăm</h3>
          <p class="kir-card-text">
            Ceea ce este relevant, funcționează și se potrivește noului obiectiv poate fi preluat.
          </p>
        </div>

        <div class="kir-card card-improve">
          <div class="kir-icon icon-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 4 23 10 17 10"></polyline>
              <polyline points="1 20 1 14 7 14"></polyline>
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
          </div>
          <h3 class="kir-card-title">Îmbunătățim</h3>
          <p class="kir-card-text">
            Ceea ce are o bază bună este revizuit țintit la nivel de conținut, navigare, design sau funcție.
          </p>
        </div>

        <div class="kir-card card-rebuild">
          <div class="kir-icon icon-yellow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <h3 class="kir-card-title">Reconstruim</h3>
          <p class="kir-card-text">
            Dacă structura sau tehnologia nu mai susțin cerințele actuale, aceste componente sunt reconstruite pe o bază potrivită.
          </p>
        </div>

      </div>
    </div>

    <div class="kir-footer">
      <p>
        Astfel rezultă o arie de proiect justificată, nu o reconstrucție completă după un model standard.
      </p>
    </div>
  </div>
</section>

<style>
  .section-kir {
    padding: 6rem 0;
    background: var(--bg-page);
  }
  
  .kir-header {
    max-width: 750px;
    margin: 0 auto 4rem;
  }
  .kir-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 800;
    color: var(--brand-navy);
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }
  .kir-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
  }

  .kir-flow-container {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    padding-top: 1rem;
  }

  .assessment-node {
    width: max-content;
    margin: 0 auto;
    background: var(--brand-navy);
    color: #fff;
    padding: 1rem 2rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    font-size: 1.1rem;
    box-shadow: 0 10px 20px rgba(15, 27, 48, 0.15);
    position: relative;
    z-index: 2;
  }

  .flow-lines {
    width: 100%;
    height: 80px;
    display: block;
    margin: -10px auto 0;
  }
  .flow-path {
    fill: none;
    stroke-width: 3;
    stroke-dasharray: 8 6;
  }
  .path-keep { stroke: #10b981; }
  .path-improve { stroke: #3b82f6; }
  .path-rebuild { stroke: #eab308; }

  .kir-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 1rem;
  }

  .kir-card {
    background: #ffffff;
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    text-align: center;
    border-top: 4px solid transparent;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    transition: transform 0.3s ease;
  }
  .kir-card:hover {
    transform: translateY(-5px);
  }

  .card-keep { border-top-color: #10b981; }
  .card-improve { border-top-color: #3b82f6; }
  .card-rebuild { border-top-color: #eab308; }

  .kir-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }
  .icon-green { background: #ecfdf5; color: #10b981; }
  .icon-blue { background: #eff6ff; color: #3b82f6; }
  .icon-yellow { background: #fefce8; color: #eab308; }
  .kir-icon svg { width: 28px; height: 28px; }

  .kir-card-title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-bottom: 0.75rem;
  }
  .kir-card-text {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .kir-footer {
    text-align: center;
    max-width: 650px;
    margin: 4rem auto 0;
    padding: 1.5rem;
    background: #f8fafc;
    border-radius: var(--radius-md);
    border: 1px dashed var(--border-light);
    color: var(--text-dark);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .flow-lines { display: none; }
    .kir-grid { grid-template-columns: 1fr; margin-top: 3rem; }
    .kir-card { margin-top: -1.5rem; }
    .assessment-node { margin-bottom: 2rem; }
  }
</style>
