---
const isRo = Astro.url.pathname.startsWith('/ro');
---
<footer class="site-footer" id="kontakt">
    <div class="container">
      <div class="footer-grid">
        <div>
          <img src="/images/pop-digital-solutions-master.svg" alt="Pop Digital Solutions" class="footer-logo">
          <p class="footer-brand-desc">
            {isRo ? "Creare site, Marketing & Design, soluții digitale și echipare pentru companii – gestionate personal și coordonate clar." : "Websites, Marketing & Design, digitale Lösungen und Firmenausstattung – persönlich geführt und klar koordiniert."}
          </p>
        </div>

        <div>
          <h4 class="footer-heading">{isRo ? "Soluții" : "Lösungen"}</h4>
          <ul class="footer-links-list">
            <li><a href={isRo ? "/ro/creare-site-pentru-firma/" : "/professionell-starten/"}>{isRo ? "Creare site pentru firmă" : "Professionell starten"}</a></li>
            <li><a href={isRo ? "/ro/refacere-si-optimizare-site/" : "/website-relaunch/"}>{isRo ? "Refacere site" : "Website-Relaunch"}</a></li>
            <li><a href={isRo ? "/ro/marketing-design/" : "/marketing-design/"}>{isRo ? "Marketing & Design" : "Marketing & Design"}</a></li>
            <li><a href={isRo ? "/ro/solutii-digitale-personalizate/" : "/individuelle-loesungen/"}>{isRo ? "Soluții digitale personalizate" : "Individuelle Lösungen"}</a></li>
            <li><a href={isRo ? "/ro/echipare-pentru-companii/" : "/firmenausstattung/"}>{isRo ? "Echipare pentru companii" : "Firmenausstattung"}</a></li>
          </ul>
        </div>

        <div>
          <h4 class="footer-heading">{isRo ? "Companie" : "Unternehmen"}</h4>
          <ul class="footer-links-list">
            <li><a href={isRo ? "/ro/portfoliu/" : "/portfolio/"}>Portfolio</a></li>
            <li><a href={isRo ? "/ro/despre-noi/" : "/about/"}>{isRo ? "Despre noi" : "Über uns"}</a></li>
            <li><a href={isRo ? "/ro/contact/" : "/projekt-anfragen/"}>{isRo ? "Solicită proiect" : "Projekt anfragen"}</a></li>
          </ul>
        </div>

        <div>
          <h4 class="footer-heading">Kontakt &amp; Legal</h4>
          <ul class="footer-links-list">
            <li><a href="mailto:office@popdigital.at">office@popdigital.at</a></li>
            <li><a href="tel:+436705515177">+43 670 5515177</a></li>
            <li><a href="https://wa.me/436705515177" target="_blank">WhatsApp Chat</a></li>
            <li><a href="#">Impressum</a></li>
            <li><a href="#">Datenschutz</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Pop Digital Solutions e.U.</span>
      </div>
    </div>
  </footer>
