---
const isRo = Astro.url.pathname.startsWith('/ro');
---
<header class="site-header" id="main-header">
  <div class="container header-inner">

    <!-- Logo only — no pill tabs -->
    <a href={isRo ? "/ro/" : "/"} class="nav-logo-link" aria-label="Pop Digital Solutions — Startseite">
      <img src="/images/pop-digital-solutions-master.svg" alt="Pop Digital Solutions" class="nav-logo-img h-9 w-auto flex-shrink-0" width="200" height="36">
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" id="desktop-nav" aria-label="Hauptnavigation">

      <!-- Lösungen dropdown -->
      <div class="nav-dropdown-wrapper" id="loesungen-dropdown">
        <button
          type="button"
          class="nav-link-simple nav-dropdown-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          id="loesungen-trigger"
        >
          {isRo ? "Soluții" : "Lösungen"}
          <svg class="dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </button>

        <div class="nav-dropdown-panel" id="loesungen-panel" role="menu" aria-labelledby="loesungen-trigger">
          <a href={isRo ? "/ro/creare-site-pentru-firma/" : "/professionell-starten/"} class="dropdown-item" role="menuitem">
            <span class="dropdown-item-icon">
              <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            </span>
            <span class="dropdown-item-text">
              <strong>{isRo ? "Creare site pentru firmă" : "Professionell starten"}</strong>
              <small>{isRo ? "Website, brand și fundație" : "Website, Marke und Grundlagen aufbauen"}</small>
            </span>
          </a>
          <a href={isRo ? "/ro/refacere-si-optimizare-site/" : "/website-relaunch/"} class="dropdown-item" role="menuitem">
            <span class="dropdown-item-icon">
              <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
              </svg>
            </span>
            <span class="dropdown-item-text">
              <strong>{isRo ? "Refacere site" : "Website-Relaunch"}</strong>
              <small>{isRo ? "Modernizarea unui site existent" : "Einen bestehenden Auftritt gezielt modernisieren"}</small>
            </span>
          </a>
          <a href={isRo ? "/ro/marketing-design/" : "/marketing-design/"} class="dropdown-item" role="menuitem">
            <span class="dropdown-item-icon">
              <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
                <path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/>
              </svg>
            </span>
            <span class="dropdown-item-text">
              <strong>{isRo ? "Marketing & Design" : "Marketing & Design"}</strong>
              <small>{isRo ? "Consolidarea mărcii și vizibilității" : "Marke, Kommunikation und Sichtbarkeit stärken"}</small>
            </span>
          </a>
          <a href={isRo ? "/ro/solutii-digitale-personalizate/" : "/individuelle-loesungen/"} class="dropdown-item" role="menuitem">
            <span class="dropdown-item-icon">
              <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
              </svg>
            </span>
            <span class="dropdown-item-text">
              <strong>{isRo ? "Soluții digitale personalizate" : "Individuelle Lösungen"}</strong>
              <small>{isRo ? "Automatizare fluxuri și sisteme" : "Abläufe automatisieren und Systeme verbinden"}</small>
            </span>
          </a>
          <a href={isRo ? "/ro/echipare-pentru-companii/" : "/firmenausstattung/"} class="dropdown-item" role="menuitem">
            <span class="dropdown-item-icon">
              <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
              </svg>
            </span>
            <span class="dropdown-item-text">
              <strong>{isRo ? "Echipare pentru companii" : "Firmenausstattung"}</strong>
              <small>{isRo ? "Îmbrăcăminte, print și promoționale" : "Bekleidung, Drucksorten und Werbetechnik"}</small>
            </span>
          </a>
        </div>
      </div>

      <a href={isRo ? "/ro/portfoliu/" : "/portfolio/"} class="nav-link-simple">Portfolio</a>
      <a href={isRo ? "/ro/despre-noi/" : "/about/"} class="nav-link-simple">{isRo ? "Despre noi" : "Über uns"}</a>

      <!-- Language Switcher -->
      <div class="nav-lang-switcher">
        <a href="/" class={isRo ? "lang-btn" : "lang-btn lang-btn--active"} style="text-decoration:none;">DE</a>
        <span class="lang-divider" aria-hidden="true">|</span>
        <a href="/ro/" class={isRo ? "lang-btn lang-btn--active" : "lang-btn"} style="text-decoration:none;">RO</a>
      </div>

      <!-- CTA -->
      <a href={isRo ? "/ro/contact/" : "/projekt-anfragen/"} class="btn-book-sprint">
        <span>{isRo ? "Solicită proiect" : "Projekt anfragen"}</span>
        <img src="/images/gabriel-antonio-pop.png" alt="Gabriel Pop" class="avatar-badge-img">
      </a>
    </nav>

    <!-- Mobile hamburger -->
    <button type="button" class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Menü öffnen" aria-expanded="false">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-nav-drawer" id="mobile-nav-drawer" aria-hidden="true">
    <div class="mobile-nav-content">
      <a href={isRo ? "/ro/" : "/"} class="mobile-nav-link active">Home</a>

      <!-- Mobile Lösungen accordion -->
      <div class="mobile-nav-accordion">
        <button type="button" class="mobile-nav-link mobile-accordion-trigger" id="mobile-loesungen-btn" aria-expanded="false">
          <span>{isRo ? "Soluții" : "Lösungen"}</span>
          <svg class="mobile-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </button>
        <div class="mobile-loesungen-panel" id="mobile-loesungen-panel" aria-hidden="true">
          <a href={isRo ? "/ro/creare-site-pentru-firma/" : "/professionell-starten/"} class="mobile-sub-link">{isRo ? "Creare site pentru firmă" : "Professionell starten"}</a>
          <a href={isRo ? "/ro/refacere-si-optimizare-site/" : "/website-relaunch/"} class="mobile-sub-link">{isRo ? "Refacere site" : "Website-Relaunch"}</a>
          <a href={isRo ? "/ro/marketing-design/" : "/marketing-design/"} class="mobile-sub-link">{isRo ? "Marketing & Design" : "Marketing & Design"}</a>
          <a href={isRo ? "/ro/solutii-digitale-personalizate/" : "/individuelle-loesungen/"} class="mobile-sub-link">{isRo ? "Soluții digitale personalizate" : "Individuelle Lösungen"}</a>
          <a href={isRo ? "/ro/echipare-pentru-companii/" : "/firmenausstattung/"} class="mobile-sub-link">{isRo ? "Echipare pentru companii" : "Firmenausstattung"}</a>
        </div>
      </div>

      <a href={isRo ? "/ro/portfoliu/" : "/portfolio/"} class="mobile-nav-link">Portfolio</a>
      <a href={isRo ? "/ro/despre-noi/" : "/about/"} class="mobile-nav-link">{isRo ? "Despre noi" : "Über uns"}</a>

      <div class="mobile-nav-divider"></div>

      <!-- Mobile Language -->
      <div class="mobile-lang-row">
        <a href="/" class={isRo ? "lang-btn" : "lang-btn lang-btn--active"} style="text-decoration:none;">DE</a>
        <span class="lang-divider" aria-hidden="true">|</span>
        <a href="/ro/" class={isRo ? "lang-btn lang-btn--active" : "lang-btn"} style="text-decoration:none;">RO</a>
      </div>

      <a href={isRo ? "/ro/contact/" : "/projekt-anfragen/"} class="btn-book-sprint" style="width:100%;justify-content:center;margin-top:0.25rem;text-decoration:none;">
        <span>{isRo ? "Solicită proiect" : "Projekt anfragen"}</span>
      </a>
    </div>
  </div>
</header>

<style>
  /* ─── Logo ──────────────────────────────────────────── */
  .nav-logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }
  .nav-logo-img {
    height: 36px;
    width: auto;
    display: block;
  }

  /* ─── Desktop Nav ───────────────────────────────────── */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* ─── Dropdown wrapper ───────────────────────────────── */
  .nav-dropdown-wrapper {
    position: relative;
  }

  .nav-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-full);
    transition: all var(--transition);
  }
  .nav-dropdown-trigger:hover,
  .nav-dropdown-trigger[aria-expanded="true"] {
    background: #ffffff;
    color: var(--brand-navy);
  }
  .dropdown-chevron {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  .nav-dropdown-trigger[aria-expanded="true"] .dropdown-chevron {
    transform: rotate(180deg);
  }

  /* ─── Dropdown Panel ─────────────────────────────────── */
  .nav-dropdown-panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 280px;
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 40px rgba(15, 23, 42, 0.12), 0 2px 8px rgba(0,0,0,0.04);
    padding: 0.4rem;
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    pointer-events: none;
  }
  .nav-dropdown-panel.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text-dark);
    transition: background var(--transition);
  }
  .dropdown-item:hover {
    background: var(--brand-purple-soft);
  }
  .dropdown-item-icon {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: #f3e8ff;
    color: #7c3aed;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .dropdown-item-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .dropdown-item-text strong {
    font-size: 0.86rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
  }
  .dropdown-item-text small {
    font-size: 0.72rem;
    color: #64748b;
    font-weight: 500;
  }

  /* ─── Language Switcher ─────────────────────────────── */
  .nav-lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin-left: 0.35rem;
  }
  .lang-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-muted);
    padding: 0.3rem 0.45rem;
    border-radius: var(--radius-sm);
    transition: all var(--transition);
    letter-spacing: 0.04em;
    line-height: 1;
  }
  .lang-btn:hover { color: var(--brand-navy); background: #ffffff; }
  .lang-btn--active { color: var(--brand-navy); }
  .lang-divider {
    color: var(--border-light);
    font-size: 0.9rem;
    user-select: none;
    line-height: 1;
  }

  /* ─── Mobile ─────────────────────────────────────────── */
  .mobile-nav-accordion { display: flex; flex-direction: column; }

  .mobile-accordion-trigger {
    background: none;
    border: none;
    cursor: pointer;
    width: 100%;
    justify-content: space-between;
    text-align: left;
  }
  .mobile-accordion-trigger[aria-expanded="true"] .mobile-chevron {
    transform: rotate(180deg);
  }
  .mobile-chevron { transition: transform 0.2s ease; }

  .mobile-loesungen-panel {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.25rem 0 0.25rem 1rem;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.3s ease;
  }
  .mobile-loesungen-panel.is-open { max-height: 400px; }

  .mobile-sub-link {
    display: block;
    padding: 0.55rem 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition);
  }
  .mobile-sub-link:hover { background: var(--brand-purple-soft); color: var(--brand-purple); }

  .mobile-lang-row {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.25rem 0;
  }

  /* ─── Responsive: hide desktop nav, show hamburger ───── */
  @media (max-width: 900px) {
    .desktop-nav { display: none; }
    .mobile-menu-toggle { display: flex; }
    .mobile-nav-drawer { display: block; }
  }
  @media (min-width: 901px) {
    .mobile-menu-toggle { display: none; }
    .mobile-nav-drawer  { display: none !important; }
  }
</style>

<script>
  (() => {
    // ─── Dropdown ────────────────────────────────────────
    const trigger  = document.getElementById('loesungen-trigger');
    const panel    = document.getElementById('loesungen-panel');

    function openDropdown() {
      trigger.setAttribute('aria-expanded', 'true');
      panel.classList.add('is-open');
    }
    function closeDropdown() {
      trigger.setAttribute('aria-expanded', 'false');
      panel.classList.remove('is-open');
    }

    trigger?.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      isOpen ? closeDropdown() : openDropdown();
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!trigger?.contains(e.target) && !panel?.contains(e.target)) {
        closeDropdown();
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDropdown();
    });

    // ─── Mobile Menu ─────────────────────────────────────
    const mobileToggle = document.getElementById('mobile-menu-toggle');
    const mobileDrawer = document.getElementById('mobile-nav-drawer');

    mobileToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = mobileToggle.classList.toggle('active');
      mobileToggle.setAttribute('aria-expanded', String(isOpen));
      mobileDrawer?.classList.toggle('active');
    });

    // Close mobile drawer when clicking links
    mobileDrawer?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileToggle?.classList.remove('active');
        mobileToggle?.setAttribute('aria-expanded', 'false');
        mobileDrawer?.classList.remove('active');
      });
    });

    document.addEventListener('click', (e) => {
      if (!mobileDrawer?.contains(e.target) && !mobileToggle?.contains(e.target)) {
        mobileToggle?.classList.remove('active');
        mobileToggle?.setAttribute('aria-expanded', 'false');
        mobileDrawer?.classList.remove('active');
      }
    });

    // ─── Mobile Lösungen accordion ────────────────────────
    const mobileAccBtn   = document.getElementById('mobile-loesungen-btn');
    const mobileAccPanel = document.getElementById('mobile-loesungen-panel');

    mobileAccBtn?.addEventListener('click', () => {
      const isOpen = mobileAccBtn.getAttribute('aria-expanded') === 'true';
      mobileAccBtn.setAttribute('aria-expanded', String(!isOpen));
      mobileAccPanel?.classList.toggle('is-open');
    });
  })();
</script>
